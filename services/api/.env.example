# Backend server
PORT=8787
OBSCURA_DB_PATH=./obscura.sqlite
# Comma-separated allowed CORS origins, or unset to reflect any origin (hackathon-local dev default).
CORS_ORIGIN=

# Guardian authorization-token signing secret (NOT a wallet key - see
# packages/guardian/src/authorizationToken.ts). Generate a real random
# value for actual use; never commit a real value here.
GUARDIAN_HMAC_SECRET=replace-with-a-random-32-byte-hex-value

# Bitrefill Personal API - obtained via bitrefill.com Account > Developers.
# Never commit a real key.
BITREFILL_API_KEY=

# Google Gemini API key for the AI shopping agent (see services/api/src/agent/geminiDriver.ts).
# Never commit a real key. Without this set, POST /api/shopping/requests
# returns 503 AGENT_NOT_CONFIGURED rather than failing to start.
GEMINI_API_KEY=

# Optional - overrides the default Gemini model. gemini-flash-latest is a
# Google-maintained alias for their current fast, function-calling-capable
# model; leave as-is unless you need a specific pinned model version.
GEMINI_MODEL=gemini-flash-latest

# Signer service (apps/signer) - the ONLY process that holds envelope wallet keys.
# The backend authenticates to it with an HMAC over each request body. Use a
# different random value from GUARDIAN_HMAC_SECRET. Without these set, the
# /fund, /envelope and /sweep routes return 503 SIGNER_NOT_CONFIGURED.
SIGNER_BASE_URL=http://127.0.0.1:8789
SIGNER_AUTH_SECRET=replace-with-a-different-random-32-byte-hex-value

# Receipt service keys (Ed25519 signing key + AES-256 payload key), created on first run.
# Holds secrets - git-ignored. If unset, ephemeral keys are used and receipts
# cannot be read or verified after a restart.
RECEIPT_KEY_FILE=./receipt-keys.json

# Trusted payment-intent configuration. The destination and the amount
# (priceMinor x rate) are built HERE, by the backend - never by the agent or
# the frontend - then bound into the guardian's token and re-verified by the signer.
# MVP: the destination is a demo settlement wallet (NOT Bitrefill; Bitrefill does not accept ZEC).
# The rate is a FIXED DEMONSTRATION RATE in zatoshi per USD cent, not a live exchange rate.
DEMO_SETTLEMENT_ADDRESS=
DEMO_ZATOSHI_PER_MINOR=10000

# Optional - where GET /api/security/scoreboard reads its last stored run
# from (written by `npm run scoreboard -w @obscura/attack-scoreboard`).
# Defaults to tests/attack-scoreboard/results/latest.json if unset.
SCOREBOARD_RESULTS_PATH=
