# Signer process env. Never commit real values.

# Same SQLite file the backend API writes to (documented MVP limitation: see
# docs/architecture/security-architecture.md section 3).
OBSCURA_DB_PATH=./obscura.sqlite
SIGNER_PORT=8789

# HMAC secret for requests FROM the backend. Must equal the backend's SIGNER_AUTH_SECRET.
# Generate a random value, different from GUARDIAN_HMAC_SECRET.
SIGNER_AUTH_SECRET=

# Verifies the guardian's authorization token. Must equal the backend's GUARDIAN_HMAC_SECRET.
GUARDIAN_HMAC_SECRET=

# Path to the zcash-devtool binary. Machine-specific - set this to wherever
# you built/installed it locally (see docs/architecture/zcash-integration.md
# section 2 for the build). Example: /path/to/zcash-devtool/target/release/zcash-devtool
ZCASH_DEVTOOL_PATH=/path/to/your/local/zcash-devtool/binary

# Directory holding the per-mandate envelope wallets (one subdirectory per
# mandate, created automatically). Git-ignored - never commit this directory.
SIGNER_WALLETS_DIR=./wallets

# Fixed, operator-configured destinations. The agent and frontend can never choose these.
# MVP: payments go to a demo settlement wallet (a second testnet wallet), NOT to Bitrefill.
DEMO_SETTLEMENT_ADDRESS=
# Sweep-back destination for revoked/expired envelopes: the user's main wallet.
USER_SWEEP_ADDRESS=

# How long to wait for the adapter before treating a payment's outcome as UNKNOWN
# (BROADCAST_UNCERTAIN: no retry, no release). Default 60000.
SIGNER_ADAPTER_TIMEOUT_MS=60000
