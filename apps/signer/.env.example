# Signer process env (never commit real values).
OBSCURA_DB_PATH=../../services/api/obscura.sqlite
SIGNER_PORT=8789
# Must equal the backend's SIGNER_AUTH_SECRET.
SIGNER_AUTH_SECRET=replace-with-a-different-random-32-byte-hex-value
# Must equal the backend's GUARDIAN_HMAC_SECRET (verifies the guardian's token binding only).
GUARDIAN_HMAC_SECRET=replace-with-a-random-32-byte-hex-value
ZCASH_DEVTOOL_PATH=C:/Users/Dnyanada/OneDrive/Desktop/zcash/tools/zcash-devtool/bin/zcash-devtool.exe
SIGNER_WALLETS_DIR=./wallets
# MVP: payments go here (a second test wallet), NOT to Bitrefill - see demo-scope.md.
DEMO_SETTLEMENT_ADDRESS=
# Sweep-back destination for revoked/expired envelopes: the user's main wallet.
USER_SWEEP_ADDRESS=
DEMO_ZATOSHI_PER_MINOR=10000
